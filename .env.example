# Path to the AC server results directory
WATCH_PATH=F:\Program Files (x86)\Steam\steamapps\common\assettocorsa\server\results

# Secret token required by the desktop agent to POST laps
INGEST_TOKEN=change-me-to-a-secret

# Port for the LapTracker API + web server
PORT=3001

# AC server HTTP API (for live session polling)
AC_API_URL=http://localhost:8081
